# ------------------------------------------------------------------
# Gigafibra TV Analytics — reporte mensual de suscripciones de TV
# Copia este archivo como backend/.env y completa los valores.
# backend/.env NUNCA se sube al repositorio (está en .gitignore).
# ------------------------------------------------------------------

APP_ENV=development
# Clave para firmar la sesión (en producción: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=cambia-esta-clave
# Cookie de sesión solo por HTTPS (por defecto true en producción). En un servidor publicado por HTTP: false
COOKIE_SECURE=
TIMEZONE=America/Bogota
# Subruta de publicación detrás de nginx (en el servidor: /comercial_reports). Vacío = raíz.
BASE_PATH=

# ---------------- ERPNext API Gigafibra ----------------
# Consulta de suscripciones "vista reporte" (todas las suscripciones, sin filtro de estado), definida en
# backend/config/consulta_postman.json (copia de la petición de la colección ERPNext API en Postman).
ERPNEXT_URL=https://next.gigafibra.co
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_TIMEOUT=300

# ---------------- Reporte ----------------
# Carpeta del reporte: Excel de cada año, snapshots .json, respaldos e historial de cortes
REPORT_DIR=data/reporte
# Un libro por año ({anio} = 2026, 2027, …). El primer corte de enero crea el libro del año nuevo.
EXCEL_FILE_PATTERN=planes TV {anio}.xlsx
EXCEL_SHEET_PATTERN=Planes TV mensual {anio}
EXCEL_TABLE=Tabla2
# Nombre del Excel descargado ({periodo} = AAAA-MM del último corte del libro)
EXCEL_DOWNLOAD_PATTERN=Planes tv corte {periodo}.xlsx
# Estados que cuentan (misma fórmula COUNTIFS del Excel)
COUNT_STATUSES=Active,Past Due Date
# Respaldos del Excel previos a cada corte (data/reporte/respaldos). El original recibido se conserva siempre.
EXCEL_BACKUPS_KEEP=3

# ---------------- Corte automático (único modo de generar cortes) ----------------
SCHEDULER_ENABLED=true
SYNC_DAY=LAST_DAY_OF_MONTH
SYNC_HOUR=23
SYNC_MINUTE=50
# Primer mes con corte automático (AAAA-MM)
REPORT_START=2026-11
CATCH_UP_ON_START=true
SYNC_MAX_ATTEMPTS=3
SYNC_RETRY_BACKOFF_SECONDS=5
SYNC_RETRY_MINUTES=30
SYNC_RETRY_MAX=3

# ---------------- Inicio de sesión ----------------
# debug → formulario local con correo @gigafibra.co (solo desarrollo) · erpnext → SSO con ERPNext (Office 365)
AUTH_MODE=debug
SESSION_HOURS=12
ALLOWED_EMAIL_DOMAINS=gigafibra.co
ALLOWED_ROLES=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8010/api/auth/callback
OAUTH_SCOPES=openid all
