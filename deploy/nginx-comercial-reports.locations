# nginx: publica Comercial reports en /comercial_reports/ (proxy al servicio en 127.0.0.1:8010).
# Copiar a /etc/nginx/comercial_reports.locations e incluirlo dentro del bloque server que atiende el sitio:
#     include /etc/nginx/comercial_reports.locations;
# Debe coincidir con BASE_PATH=/comercial_reports (backend/.env) y con VITE_BASE_PATH al compilar el frontend.
# La URL .../comercial_reports/api/auth/callback debe estar en OAUTH_REDIRECT_URI y en el OAuth Client de ERPNext.

location = /comercial_reports {
    return 301 /comercial_reports/;
}

location ^~ /comercial_reports/ {
    proxy_pass http://127.0.0.1:8010;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
    client_max_body_size 5m;
}

# La carpeta del proyecto está dentro del webroot: nunca servir sus archivos (.env, Excel, .json con datos de clientes).
location ^~ "/Comercial reports" {
    return 404;
}
